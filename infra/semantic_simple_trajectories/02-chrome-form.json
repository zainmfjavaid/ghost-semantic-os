{
  "name": "Chrome form semantics",
  "coverage": ["chrome", "web-form", "editable-controls", "public-type", "public-click"],
  "task_path": "OSWorld/evaluation_examples/examples/chrome/f79439ad-3ee8-4f99-a518-0eb60e5652b0.json",
  "max_tool_calls": 20,
  "quality_constraints": {"min_chars": 1, "max_chars": 10000, "max_estimated_tokens": 2500, "max_duplicate_lines": 0, "forbid_protocol_jargon": true, "zero_images": true},
  "steps": [
    {"op": "read", "expect": {"contains": ["COMPUTER", "Chrome"], "active_header_contains": "Chrome", "active_header_not_contains": "gnome-shell", "min_surface_count": 1, "min_element_count": 1, "min_returned_elements": 1}},
    {"op": "read", "query": "textbox To", "expect": {"contains": ["COMPUTER", "textbox \"To\""], "active_header_contains": "Chrome", "min_surface_count": 1, "min_element_count": 1, "min_returned_elements": 1}},
    {"op": "type", "match": {"contains": "textbox \"To\" type=replace"}, "text": "Dublin", "expect": {"contains": "COMPUTER", "active_header_contains": "Chrome", "active_header_not_contains": "gnome-shell", "min_surface_count": 1, "min_element_count": 1, "min_returned_elements": 1}},
    {"op": "read", "query": "button Search", "expect": {"contains": ["COMPUTER", "button \"Search\" click"], "active_header_contains": "Chrome", "min_surface_count": 1, "min_element_count": 1, "min_returned_elements": 1}},
    {"op": "click", "match": {"contains": "button \"Search\" click"}, "expect": {"contains": "COMPUTER", "active_header_contains": "Chrome", "active_header_not_contains": "gnome-shell", "min_surface_count": 1, "min_element_count": 1, "min_returned_elements": 1}}
  ]
}
